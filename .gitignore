# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/playwright/.cache/
# saved auth sessions for the live QA sweep — contain session tokens, never commit
/.auth/
# QA run logs (regenerable)
/qa-*.log

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# seed scripts (contain credentials)
scripts/seed-lesly.js
scripts/seed-admin.js
supabase/seeds/

# QA screenshots — regenerable via scripts/qa-shots.mjs + qa-sections.mjs
docs/qa-screenshots/

# QA speech fixture (downloaded on demand by qa-transcript.mjs)
scripts/qa-speech-sample.wav

# Self-hosted Excalidraw runtime assets (copied at build by scripts/copy-excalidraw-assets.mjs)
public/excalidraw/
